# Copy this file to .env.local (never commit .env.local) and fill in the values.
# On Vercel: Project -> Settings -> Environment Variables (add the same names), then redeploy.

# --- SMTP (required in production) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true            # true for port 465, false for port 587
SMTP_USER=akashdhere418@gmail.com
SMTP_PASS=srvfyuoxjcrpvidf   # Gmail: Google Account -> Security -> 2-Step Verification -> App passwords
MAIL_FROM="EDAS Website <akashdhere418@gmail.com>"   # Gmail requires this to match SMTP_USER
MAIL_TO=akashdhere418@gmail.com,akashdhere1697@gmail.com             # where enquiries arrive; separate several with commas

# --- Optional extras ---
# Extra allowed site origins (comma separated) if the form is posted from another domain, e.g. a preview URL
# ALLOWED_ORIGINS=https://edasprojects.com,https://www.edasprojects.com

# Cloudflare Turnstile (free, strongest anti-bot). Create at dash.cloudflare.com -> Turnstile. Set BOTH keys to enable.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
